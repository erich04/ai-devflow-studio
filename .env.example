# DevFlow Studio self-hosted pilot configuration.
#
# Copy to .env, fill every blank required value, and never commit real secrets.

POSTGRES_DB=devflow
POSTGRES_PASSWORD=
POSTGRES_USER=postgres

DEVFLOW_API_PORT=4310
DEVFLOW_WEB_PORT=4311
DEVFLOW_PUBLIC_API_BASE_URL=http://127.0.0.1:4310
DEVFLOW_WEB_APP_URL=http://127.0.0.1:4311
DEVFLOW_DATABASE_STATEMENT_TIMEOUT_MS=15000

# Compose fixes these pilot invariants; they are shown here for operator clarity.
DEVFLOW_DEPLOYMENT_PROFILE=pilot
DEVFLOW_REQUIRE_AUTH=true
DEV_AUTH_ENABLED=false
# Development-only local browser identity must remain disabled in the Pilot profile.
DEVFLOW_LOCAL_AUTH_ENABLED=false
DEVFLOW_ENABLE_DEMO_DATA=false
DEVFLOW_ENABLE_FAKE_RUNTIME=false

# Generate two independent random values of at least 32 characters.
DEVFLOW_SESSION_SECRET=
DEVFLOW_AGENT_CREDENTIAL_KEY=

# Pilot login bootstrap is GitHub OAuth and all three values are required.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:4310/api/auth/github/callback

# Optional V1.5 GitHub Delivery authority. Keep this separate from login OAuth.
# Encode the GitHub App RSA private-key PEM as one base64 value before storing it here.
DEVFLOW_GITHUB_APP_ID=
DEVFLOW_GITHUB_APP_PRIVATE_KEY_BASE64=
