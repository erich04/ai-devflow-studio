{
  "name": "@ai-devflow/api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "db:seed": "tsx src/db/seed-demo.ts",
    "db:seed:prod": "node dist/seed-demo.js",
    "db:cleanup-demo": "tsx src/db/cleanup-demo.ts",
    "db:setup": "corepack pnpm db:migrate"
  },
  "dependencies": {
    "@ai-devflow/shared": "workspace:*",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
