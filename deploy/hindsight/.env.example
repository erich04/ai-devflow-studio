# Copy to deploy/hindsight/.env. The .env file is ignored by Git.
# Default: start the real API, database, local embedder and reranker,
# without a callable text-generation model or any model charges.
DEVFLOW_HINDSIGHT_API_PORT=8890
DEVFLOW_HINDSIGHT_UI_PORT=9990
DEVFLOW_HINDSIGHT_LLM_PROVIDER=openai
DEVFLOW_HINDSIGHT_LLM_MODEL=devflow-unconfigured
DEVFLOW_HINDSIGHT_LLM_BASE_URL=http://127.0.0.1:9/v1
DEVFLOW_HINDSIGHT_LLM_API_KEY=devflow-no-provider

# Configure an approved provider/model/budget before real retain tests.
# A healthy service does not prove that LLM extraction works.
# Do not put DEVFLOW_HINDSIGHT_PROTOCOL_VERIFIED here: it belongs to
# Electron and must only be set after the separate acceptance checks.
