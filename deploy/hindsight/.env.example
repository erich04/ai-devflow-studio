# Copy to deploy/hindsight/.env. The .env file is ignored by Git.
DEVFLOW_HINDSIGHT_API_PORT=8890
DEVFLOW_HINDSIGHT_UI_PORT=9990
# Hindsight sends its extraction and consolidation calls to DevFlow's memory relay
# (ADR 0030). The relay charges the paired project's model budget and uses the project's
# saved Provider; Hindsight never holds a Provider key.
# Paste the token from the file named in the desktop's project memory status
# (<userData>/memory-relay-token), or start the desktop with the same
# DEVFLOW_MEMORY_RELAY_TOKEN value. Without a matching token every call is refused
# and nothing is charged.
DEVFLOW_MEMORY_RELAY_TOKEN=
# Must match the desktop's DEVFLOW_MEMORY_RELAY_PORT when that is changed.
DEVFLOW_MEMORY_RELAY_PORT=8891
# Optional Hugging Face mirror for the one-time model download when the image is built.
# The files must still match deploy/hindsight/multilingual-e5-small.sha256.
# DEVFLOW_HF_ENDPOINT=https://huggingface.co
# Do not put DEVFLOW_HINDSIGHT_PROTOCOL_VERIFIED here: it belongs to
# Electron and must only be set after the separate acceptance checks.
